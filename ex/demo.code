; demo
fase = ⌊ runtime·2 ⌋
fasetijd = (runtime·2) mod 1
;fase = ⌊ muis.x / 100 · 5 ⌋
;fasetijd = (muis.x / 100 · 5) mod 1

if fase = 0 then
	out = draw [ square(0,0,9) ]
end

x1 = 0..(fasetijd·18)·10

if fase = 1 then
	out = draw ( (x1 × [0] × [9]) map square)
end

x2 = 0..18·10
y2 = 10·(0..(fasetijd·10))

if fase = 2 then
	out = draw ( (x2 × y2 × [9]) map square)
end

y3 = 0..10·10

if fase = 3 then
	out = draw ( (x2 × y3 × [9]) map square)
end

;if fase ≥ 5 then
	;out = draw ( (x2 × y3 × [9]) filter isaan map square)
;end


; wegschalen
uitschaal = (x,y),z → [x,y,z] · (1 - fasetijd · 0.9)
if fase = 4 then
	out = draw ( (x2 × y3 × [9+fasetijd]) map uitschaal map square)
end

dx = ix - 80
dy = iy - 50
dst = (dx²+dy²)/4
isaan = (ix,iy),iz → ((fasetijd·100 - dst + 3000) mod 50) < 10 / fasetijd


; klein infaden
if fase = 5 then
	out = draw ( (0..18 × 0..10 × [1.1]) filter isaan map square)
end

dx1 = ix1 - 80
dy1 = iy1 - 50
dst1 = (dx1²+dy1²)/4
isaan2 = (ix1,iy1),iz1 → ((fasetijd·100 - dst1 + 3000) mod 50) < 10

; klein opschalen
if fase = 6 then
	out = draw ( (0..(18+18·fasetijd·9) × 0..(10+10·fasetijd·10) × [1.1]) filter isaan2 map square)
end

; klaar
if fase ≥ 7 then
	out = draw ( (0..180 × 0..100 × [1.1]) filter isaan2 map square)
end










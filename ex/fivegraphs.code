; funny graphs

f = c → 50 + 10 · tan(c³) · sin(c²/10+runtime)
g = d → 50
h = e → 50 + 30 · sin(e²-3+1.1^runtime)
i = E → 50 + clamp(10·sin(E/10·runtime),0,10)
j = F → 50 + 20 · sin F/8 + 10 · sin (F/17) + (runtime·F) mod 10

x = 0..200
y1 = x map f
y2 = x map g
y3 = x map h
y4 = x map i
y5 = x map j

punten1 = x zip y1
punten2 = x zip y2
punten3 = x zip y3
punten4 = x zip y4
punten5 = x zip y5
grafiek1 = paint(line(punten1), color.red)
grafiek2 = paint(line(punten2), color.green)
grafiek3 = paint(line(punten3), color.blue)
grafiek4 = paint(line(punten4), color.yellow)
grafiek5 = paint(line(punten5), rgb(1,runtime mod 1,1))

out = draw [grafiek1, grafiek2, grafiek3, grafiek4, grafiek5]


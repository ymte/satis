; 3D Buis

; loop met pijltjes en WASD
veld2 = -2..3 × -2..3 × -2..3 × [1]
veld = veld2; map ((((A,B),C),D) → (X,Y,Z,1))
X = cos ((A/5+B/25)·τ+runtime)
Y = sin ((A/5+B/25)·τ+runtime)
Z = C/2

l = runtime / 100

; camera
x := 0
y := 0
z := 0

if key.w then z := z + .1 end
if key.s then z := z - .2 end
if key.d then x := x - .1 end
if key.a then x := x + .1 end
if key.up then y := y - .1 end
if key.down then y := y + .1 end

; viewport
rechts    = [10·cos x,0,10·sin x,0]
boven     = [0,10,0,0]
rechtdoor = [10·sin x,0,10·-cos x,0]
pos       = [90,55+y,-z·20+muis.x,50,1]

matrix = [rechts, boven, rechtdoor, pos]

K = 20/pz-10
k = rgb(K/w₀,K/w₁,K/w₂)
h = matrix · w

transformeer = w → h
plot = px,py,pz·(mouse.x-10),pw → verf(cirkel( ((px-90)/pz+90,(py-50)/pz+50), max(0,3/pz)), k)


punten = veld map transformeer
gesorteerd = punten sort ggg
ggg = fa,fb → fa₂ < fb₂

out = draw (gesorteerd map plot)


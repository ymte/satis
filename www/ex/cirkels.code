; concentric circles
w = 180
h = 100
pos = 0..w × 0..h

; circlepattern
dx = x - mouse.x
dy = y - mouse.y
dst = √(dx²+dy²)

; is the block on (x,y) on?
ison(x,y) = golf < sin(runtime)+2
golf = (runtime·10 - dst) mod 5
blocks = pos filter isaan

; blocks
shape = square(a·1,b·1,1) paint color
color = rgb(a/100,b/100,blue)
blue = sin(runtime)/2+0.5
squares = blocks map (a,b → shape)
out = draw squares
